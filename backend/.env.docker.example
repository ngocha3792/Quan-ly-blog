# Copy sang .env.docker rồi điền giá trị thật.
#   cp .env.docker.example .env.docker
#   chmod 600 .env.docker
# .env.docker không được commit (đã có trong .gitignore).

# --- PostgreSQL container (dùng bởi service "postgres" trong compose.local.yml) ---
POSTGRES_USER=blog
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=blog

# DATABASE_URL trỏ vào service "postgres" trong cùng docker network.
# Nếu muốn dùng database bên ngoài (vd: Prisma Postgres đang dùng ở .env),
# thay giá trị này và có thể bỏ service "postgres" trong compose.
DATABASE_URL="postgresql://blog:change-me-local-only@postgres:5432/blog?schema=public"

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_DEFAULT_FOLDER="nestJS_blog"

# --- Pepper để băm cùng bcrypt ---
PASSWORD_PEPPER="change-me"

# --- AccessToken và RefreshToken ---
JWT_ACCESS_TOKEN_SECRET="change-me"
JWT_REFRESH_TOKEN_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Database ---
DB_POOL_SIZE="10"
DB_LOG_QUERIES="true"

# --- App ---
APP_PORT="8080"
NODE_ENV="production"
APP_NAME="Blog API"
API_PREFIX="api/v1"
FRONTEND_URL="http://localhost:4200"
MAINTENANCE_MODE="false"

# --- Email SMTP ---
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_SECURE="false"
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="NestJS Blog <no-reply@example.com>"
MAIL_IGNORE_TLS="false"

TRANSLATE_API_URL="http://localhost:5000"

# Public view deduplication
VIEWER_KEY_SECRET="replace-with-a-long-random-secret"

# 0 nếu app chạy trực tiếp (đúng khi test local Docker không có Nginx trước mặt).
TRUST_PROXY_HOPS="0"

TOP_POSTS_CANDIDATE_DAYS=90
TOP_POSTS_CACHE_TTL_SECONDS=120
