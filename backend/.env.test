NODE_ENV=test

# BẮT BUỘC phải là database riêng cho E2E.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blog_e2e

JWT_ACCESS_TOKEN_SECRET=e2e-access-secret-at-least-32-characters
JWT_REFRESH_TOKEN_SECRET=e2e-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PASSWORD_PEPPER=e2e-password-pepper

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Blog E2E <e2e@example.com>
MAIL_IGNORE_TLS=true

MAINTENANCE_MODE=false

VIEWER_KEY_SECRET=e2e-viewer-key-secret-at-least-32-chars
TRUST_PROXY_HOPS=0

TOP_POSTS_CANDIDATE_DAYS=90
TOP_POSTS_CACHE_TTL_SECONDS=120
