# Copy file này thành .env và thay toàn bộ giá trị placeholder.
# Không commit .env hoặc bất kỳ credential thật nào.

# PostgreSQL / Prisma
# Dùng chuỗi hex dài để password không phải URL-encode trong DATABASE_URL.
POSTGRES_USER="blog_user"
POSTGRES_PASSWORD="replace-with-a-long-random-hex-password"
POSTGRES_DB="blog"
DATABASE_URL="postgresql://blog_user:replace-with-a-long-random-hex-password@postgres:5432/blog?schema=public"
DB_POOL_SIZE="10"
DB_LOG_QUERIES="false"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_DEFAULT_FOLDER="nestjs_blog"

# Secrets xác thực - tạo chuỗi ngẫu nhiên riêng cho từng biến
PASSWORD_PEPPER="replace-with-a-long-random-password-pepper"
JWT_ACCESS_TOKEN_SECRET="replace-with-a-long-random-access-token-secret"
JWT_REFRESH_TOKEN_SECRET="replace-with-a-different-long-random-refresh-token-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
VIEWER_KEY_SECRET="replace-with-a-long-random-viewer-key-secret"

# Ứng dụng
APP_PORT="8080"
# Cổng HTTP công khai do Nginx lắng nghe trên VPS
HTTP_PORT="80"
NODE_ENV="production"
APP_NAME="Blog API"
API_PREFIX="api/v1"
FRONTEND_URL="https://your-frontend.example.com"
MAINTENANCE_MODE="false"
TRUST_PROXY_HOPS="1"
TOP_POSTS_CANDIDATE_DAYS="90"
TOP_POSTS_CACHE_TTL_SECONDS="120"

# SMTP
MAIL_HOST="smtp.example.com"
MAIL_PORT="587"
MAIL_SECURE="false"
MAIL_USER="your-smtp-user"
MAIL_PASSWORD="your-smtp-password"
MAIL_FROM="Blog API <no-reply@example.com>"
MAIL_IGNORE_TLS="false"

# Dịch vụ dịch thuật tùy chọn
TRANSLATE_API_URL="http://translate-service:5000"
