# Copy file này thành .env.test để chạy test cục bộ.
# Chỉ dùng database test riêng, không dùng database production.

NODE_ENV="test"
DATABASE_URL="postgresql://blog_test:change-me@localhost:5432/blog_test?schema=public"
DB_POOL_SIZE="5"
DB_LOG_QUERIES="false"

CLOUDINARY_CLOUD_NAME="test-cloud-name"
CLOUDINARY_API_KEY="test-api-key"
CLOUDINARY_API_SECRET="test-api-secret"
CLOUDINARY_DEFAULT_FOLDER="nestjs_blog_test"

JWT_ACCESS_TOKEN_SECRET="test-only-access-token-secret-change-me"
JWT_REFRESH_TOKEN_SECRET="test-only-refresh-token-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PASSWORD_PEPPER="test-only-password-pepper-change-me"
VIEWER_KEY_SECRET="test-only-viewer-key-secret-change-me"

APP_PORT="8081"
APP_NAME="Blog API Test"
API_PREFIX="api/v1"
FRONTEND_URL="http://localhost:4200"
MAINTENANCE_MODE="false"
TRUST_PROXY_HOPS="0"
TOP_POSTS_CANDIDATE_DAYS="90"
TOP_POSTS_CACHE_TTL_SECONDS="120"

MAIL_HOST="localhost"
MAIL_PORT="1025"
MAIL_SECURE="false"
MAIL_USER="test-user"
MAIL_PASSWORD="test-password"
MAIL_FROM="Blog API Test <test@example.com>"
MAIL_IGNORE_TLS="true"

TRANSLATE_API_URL="http://localhost:5000"
